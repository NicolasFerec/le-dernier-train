config_version=5

[application]
config/name="Le Dernier Train Launcher"
run/main_scene="res://splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=480
window/size/viewport_height=250
window/size/resizable=false

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.13, 1)

[internationalization]
locale/fallback="fr"
locale/translations=PackedStringArray("res://locale/game.fr.translation", "res://locale/game.en.translation")
