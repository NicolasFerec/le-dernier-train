; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Le Dernier Train"
config/version="0.1.6"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
NetworkTime="*res://addons/netfox/network-time.gd"
NetworkTimeSynchronizer="*res://addons/netfox/network-time-synchronizer.gd"
NetworkRollback="*res://addons/netfox/rollback/network-rollback.gd"
NetworkEvents="*res://addons/netfox/network-events.gd"
NetworkPerformance="*res://addons/netfox/network-performance.gd"
GameSettings="*res://ui/game_settings.gd"
GameAudio="*res://audio/game_audio.gd"

Session="*res://network/session.gd"
Profile="*res://progression/profile.gd"
ControlHints="*res://input/control_hints.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=520
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input]

move_left={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"keycode":4194319), Object(InputEventJoypadButton,"button_index":13), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"keycode":4194321), Object(InputEventJoypadButton,"button_index":14), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
move_up={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"keycode":4194320), Object(InputEventJoypadButton,"button_index":11), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"keycode":4194322), Object(InputEventJoypadButton,"button_index":12), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":0)]
}
attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74), Object(InputEventJoypadButton,"button_index":2)]
}
dodge={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":32), Object(InputEventJoypadButton,"button_index":1)]
}
session_menu={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]
}

previous_menu_tab={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":65), Object(InputEventJoypadButton,"button_index":9)]
}
next_menu_tab={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":69), Object(InputEventJoypadButton,"button_index":10)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.12, 1)

[internationalization]

locale/fallback="fr"
locale/translations=PackedStringArray("res://locale/game.fr.translation", "res://locale/game.en.translation")

[steam]

app_id=480


[editor_plugins]

enabled=PackedStringArray("res://addons/netfox.internals/plugin.cfg", "res://addons/netfox/plugin.cfg")

[netfox]

events/enabled=false
time/tickrate=60
time/sync_to_physics=true
rollback/enable_diff_states=false
