; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Arène coop"
config/version="0.1.5"
run/main_scene="res://arena/arena.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Session="*res://network/session.gd"
Profile="*res://progression/profile.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=520
window/stretch/mode="canvas_items"

[rendering]
textures/canvas_textures/default_texture_filter=0

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.12, 1)

[internationalization]

locale/fallback="fr"
locale/translations=PackedStringArray("res://locale/game.fr.translation", "res://locale/game.en.translation")

[steam]

app_id=480
